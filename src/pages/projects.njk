---
layout: base
permalink: /projects/index.html
title: 'Projects'
description: 'A few projects Stefan Taitano has built, including a family sticker machine, this site, and a Python Asteroids game.'
---

<div class="wrapper flow projects">
  {% set kicker = "Making" %}
  {% set intro = "A few things I've built while learning. The list is short because I only want to include projects I can actually talk about." %}
  {% include "partials/page-intro.njk" %}

  <div class="projects-grid grid">
    {% for project in projects %}
      {% if not project.draft %}
        <article class="project-card flow">
          <div class="project-card__header flow">
            <h2 class="project-card__title">{{ project.title }}</h2>
            <div class="project-card__meta" aria-label="Project status and date">
              <span>{{ project.status }}</span>
              <span>{{ project.date }}</span>
            </div>
            <div class="cluster gutter-xs">
              {% for tag in project.tech %}
                <span class="project-card__tag">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
          <p>{{ project.description }}</p>
          <dl class="project-card__proof">
            <div>
              <dt>Why I built it</dt>
              <dd>{{ project.challenge }}</dd>
            </div>
            <div>
              <dt>What came out of it</dt>
              <dd>{{ project.result }}</dd>
            </div>
          </dl>
          <div class="project-card__actions cluster gutter-s">
            {% if project.url %}
              <a class="button" data-button-variant="primary" href="{{ project.url }}">View {{ project.title }} live</a>
            {% elif project.article %}
              <a class="button" data-button-variant="primary" href="{{ project.article }}">Read how I built it</a>
            {% endif %}
            {% if project.article and project.url %}
              <a class="button" data-ghost-button href="{{ project.article }}">Read how I built it</a>
            {% endif %}
            {% if project.repo %}
              <a class="button" data-ghost-button href="{{ project.repo }}">View {{ project.title }} source</a>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% css "local" %}
  {% include "css/projects.css" %}
{% endcss %}
