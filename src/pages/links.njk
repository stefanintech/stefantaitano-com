---
layout: base
permalink: /links/index.html
title: Stefan Taitano — Links
description: 'Links and contact for Stefan Taitano — ServiceNow developer, learning Ruby.'
compactHeader: true
---

<div class="links-page wrapper region">
  <div class="links-profile flow">
    <button type="button" class="links-avatar" id="links-avatar" aria-label="Stefan Taitano" aria-haspopup="dialog" aria-controls="links-egg">
      <img
        src="/assets/images/stefan.png"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        sizes="min(18rem, 100vw)"
        eleventy:widths="288,576"
      >
    </button>

    <p class="links-hint handwritten">
      <span class="links-hint__touch">hold the photo</span>
      <span class="links-hint__keyboard">type <kbd>stefan</kbd></span>
    </p>

    <div class="links-identity flow">
      <h1 class="links-name">Stefan Taitano</h1>
      <p class="links-tagline">
        {{ links.tagline }}
        {%- if links.event and helpers.isOnOrBefore(links.eventUntil) %}
          · {{ links.event }}
        {%- endif %}
      </p>
    </div>

    <nav class="links-nav flow" aria-label="Stefan's links">
      {%- for item in links.links %}
        {%- if item.url_key %}
          {%- set href = personal.platforms[item.url_key] %}
        {%- elif item.email %}
          {%- set href = "mailto:" + personal.email %}
        {%- else %}
          {%- set href = item.url %}
        {%- endif %}
        <a
          href="{{ href }}"
          class="button links-button"
          {%- if item.variant == "ghost" %} data-ghost-button{% else %} data-button-variant="primary"{% endif %}
          {%- if item.url_key %} rel="me"{% endif %}
        >{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</div>

<div class="links-egg" id="links-egg" hidden>
  <button type="button" class="links-egg__backdrop" data-close tabindex="-1" aria-label="Close"></button>
  <div
    class="links-egg__card flow"
    role="dialog"
    aria-modal="true"
    aria-labelledby="links-egg-title"
  >
    <p class="links-egg__pawn" aria-hidden="true">♟</p>
    <h2 id="links-egg-title" class="links-egg__title">You found it.</h2>
    <p class="links-egg__copy">Challenge me on Lichess. I'm Late2TheBoard.</p>
    <div class="links-egg__actions cluster gutter-s">
      <a class="button" data-button-variant="tertiary" href="{{ personal.platforms.lichess }}" rel="me">Open my board</a>
      <button type="button" class="button" data-ghost-button data-close>Close</button>
    </div>
  </div>
</div>

<script type="module" src="/assets/scripts/components/custom-links-egg.js"></script>

{% css "local" %}
  {% include "css/links.css" %}
{% endcss %}
