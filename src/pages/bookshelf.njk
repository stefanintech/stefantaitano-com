---
layout: base
permalink: /bookshelf/index.html
title: 'Bookshelf'
description: 'What Stefan Taitano is reading and listening to - mostly audiobooks, always books.'
---

<div class="wrapper flow bookshelf">
  {% set kicker = "Reading" %}
  {% set intro = "What I'm reading, have read, and want to read next. Most of these went through my ears, not my eyes. A book is a book." %}
  {% set introNote %}I usually listen through Libro.fm. If you want to try it, here's my <a href="https://libro.fm/referral?rf_code=lfm1105085">referral link</a>.{% endset %}
  {% include "partials/page-intro.njk" %}

  {% set statusGroups = [
    { key: 'reading', label: 'Currently reading' },
    { key: 'finished', label: 'Finished' },
    { key: 'queued', label: 'Up next' }
  ] %}
  {% set grouped = books | groupby('status') %}

  {% for group in statusGroups %}
    {% set groupBooks = grouped[group.key] %}
    {% if group.key == 'finished' and groupBooks %}
      {% set groupBooks = groupBooks | sort(true, false, 'finished') %}
    {% endif %}
    {% if groupBooks %}
      <section class="bookshelf-group flow">
        <p class="bookshelf-group__label handwritten">{{ group.label }}</p>
        <div class="bookshelf-grid grid">
          {% for book in groupBooks %}
            <article class="bookshelf-card flow">
              <div class="bookshelf-card__header flow">
                <h2 class="bookshelf-card__title">
                  {% if book.url %}
                    <a href="{{ book.url }}">{{ book.title }}</a>
                  {% else %}
                    {{ book.title }}
                  {% endif %}
                </h2>
                <p class="bookshelf-card__author">by {{ book.author }}</p>
                <div class="cluster gutter-xs">
                  <span class="bookshelf-card__tag">{{ book.format }}</span>
                  {% if book.finished %}
                    <span class="bookshelf-card__tag">{{ book.finished }}</span>
                  {% endif %}
                </div>
              </div>
              {% if book.note %}
                <p>{{ book.note }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</div>

{% css "local" %}
  {% include "css/bookshelf.css" %}
{% endcss %}
