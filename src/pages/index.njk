layout: base
permalink: /index.html
title: 'Stefan Taitano'
description: 'Army veteran, ServiceNow developer, and Ruby learner writing about code, work, and life outside both.'
articles:
  title: 'Recent Articles'
  intro: 'A few things I have written lately.'
---

{% include "partials/pixel-hero.njk" %}

<div class="wrapper flow">
  <section class="home-intro region">
    <div class="home-intro__content flow">
      <h1 class="home-intro__title">I build systems for a living and escape plans for fun.</h1>
      <p class="handwritten">
        (right now that means Ruby, running, and planning our next move)
      </p>
      <p class="home-intro__bio">
        I'm Stefan. I spent nine years in the Army, now work in ServiceNow, and am slowly getting better at Ruby.
      </p>
      <div class="home-intro__actions cluster gutter-s">
        <a href="/talks/rubyconf-2026/" class="button" data-button-variant="tertiary">Read my first talk</a>
        <a href="/resume/" class="button" data-ghost-button>View my résumé</a>
      </div>
    </div>
  </section>

  <section id="now-preview" class="home-now region flow">
    <p class="home-kicker handwritten">What I'm doing now</p>
    <p>
      I'm attending <a href="https://www.commityourcode.com/">Commit Your Code</a> (CYC26) in Plano,
      and I'm open to connecting. If you're here too, come say hi.
    </p>
    <p>
      I'm still working through <a href="https://www.theodinproject.com/">The Odin Project</a> Ruby path
      after RubyConf.
    </p>
    <p><a href="/now/">See the full /now page</a></p>
  </section>

  <section class="home-articles region flow">
    <h2>{{ articles.title }}</h2>
    {% set itemList = collections.allPosts %}
    {% if itemList.length > 0 %}
      {% if articles.intro %}
        <p>{{ articles.intro }}</p>
      {% endif %}
    {% else %}
      <p>No articles published yet. When something is ready, it will show up here.</p>
    {% endif %}
    {% if itemList.length > 0 %}
      <div class="home-articles__list">
        <custom-masonry layout="50-50">
          {% asyncEach item in itemList.slice(0, 3) %}
            {% set headingLevel = "h3" %}
            {% include "partials/card-blog.njk" %}
          {% endeach %}
        </custom-masonry>
      </div>
    {% endif %}
    <p><a href="/articles/">Browse all articles</a></p>
  </section>

  <section id="newsletter" class="home-newsletter region">
    {% include "partials/newsletter-cta.njk" %}
  </section>
</div>

{% css "local" %}
  {% include "css/home.css" %}
{% endcss %}
