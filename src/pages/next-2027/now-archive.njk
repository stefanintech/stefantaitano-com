<h1>Archive</h1>
<p class="next-now__lead">Dated notes already on <a href="/now/">/now</a>. <a href="/next-2027/now/">Current snapshot</a>.</p>

<ol class="next-archive" role="list">
  {%- for entry in collections.nowEntries %}
    {%- set day = entry.date | formatDateUtc('YYYY-MM-DD') %}
    {%- set slug = entry.fileSlug %}
    <li>
      <a href="/now/#{{ entry | nowAnchor }}">
        <time datetime="{{ day }}">{{ entry.date | formatDateUtc('MMMM D, YYYY') }}</time>
        {%- if slug and slug != day %}
          <span class="next-archive__slug">{{ slug | replace('-', ' ') }}</span>
        {%- endif %}
      </a>
    </li>
  {%- endfor %}
</ol>
