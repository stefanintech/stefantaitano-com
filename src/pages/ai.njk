---
layout: base
permalink: /ai/index.html
title: How I Use AI
description: How Stefan Taitano uses AI to pull together family logistics, get back into Ruby, and watch for updates he doesn't want to keep checking.
lastUpdated: '2026-09-24'
---

<div class="wrapper flow ai-page">
  {% set kicker = "Personal AI" %}
  {% set intro = "I use AI for a few ordinary things that kept eating my time: figuring out what my family has going on, getting back into Ruby after a break, and watching for updates I don't want to keep checking. These are the three workflows that have been useful enough to stick around." %}
  {% include "partials/page-intro.njk" %}

  {% for workflow in aiWorkflows.workflows %}
    <article class="ai-workflow flow" id="{{ workflow.slug }}" aria-labelledby="{{ workflow.slug }}-title">
      <header class="ai-workflow__header flow">
        <h2 class="ai-workflow__title" id="{{ workflow.slug }}-title">{{ workflow.title }}</h2>
        <p class="ai-workflow__meta">
          <span class="visually-hidden">Status: </span>
          <span class="ai-status">{{ workflow.status }}</span>
          <span aria-hidden="true">·</span>
          <span class="visually-hidden">Tools: </span>
          {{ workflow.primaryTools | join(' + ') }}
        </p>
      </header>

      <p class="ai-workflow__summary">{{ workflow.summary }}</p>

      {% if workflow.flow %}
        <ol class="ai-flow" role="list" aria-label="How {{ workflow.title }} flows">
          {% for step in workflow.flow %}
            <li>
              <span class="ai-flow__step">{{ step }}</span>
              {% if not loop.last %}
                <span class="ai-flow__arrow" aria-hidden="true">→</span>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      {% endif %}

      {% if workflow.artifacts %}
        <div class="ai-artifacts">
          {% for artifact in workflow.artifacts %}
            {% if artifact.image and artifact.enlarge %}
              {% if artifact.fit %}
                {% set shotWidths = [800, 1200, 1800] %}
                {% set shotSizes = "(min-width: 64em) 64rem, 100vw" %}
                {% set fullSizes = "1800px" %}
              {% else %}
                {% set shotWidths = [800, 1200, 1800, 2550] %}
                {% set shotSizes = "(min-width: 64em) 58rem, 48rem" %}
                {% set fullSizes = "64rem" %}
              {% endif %}
              <figure class="ai-artifact ai-artifact--page{% if artifact.fit %} ai-artifact--fit{% endif %}">
                <dialog class="ai-artifact__dialog" aria-labelledby="{{ workflow.slug }}-artifact-caption">
                  <div class="cluster gutter-s">
                    <button type="button" data-close class="button" autofocus data-button-variant="primary">
                      {{ meta.dialog.close }}
                    </button>
                  </div>
                  {% imageKeys {
                    "src": artifact.image,
                    "alt": artifact.alt | trim,
                    "loading": "lazy",
                    "imageClass": "ai-artifact__full",
                    "widths": shotWidths,
                    "sizes": fullSizes
                  } %}
                </dialog>
                <div class="ai-artifact__frame">
                  <div class="ai-artifact__page">
                    {% imageKeys {
                      "src": artifact.image,
                      "alt": artifact.alt | trim,
                      "loading": "lazy",
                      "imageClass": "ai-artifact__img",
                      "widths": shotWidths,
                      "sizes": shotSizes
                    } %}
                  </div>
                </div>
                <button type="button" class="ai-artifact__open" data-index="{{ loop.index }}" aria-haspopup="dialog">
                  View larger
                </button>
                <figcaption id="{{ workflow.slug }}-artifact-caption">{{ artifact.caption | trim }}</figcaption>
              </figure>
            {% elif artifact.image %}
              {% image artifact.image, artifact.alt | trim, artifact.caption | trim, "lazy", "ai-artifact" %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if workflow.rules %}
        <section class="ai-rules flow" aria-labelledby="{{ workflow.slug }}-rules">
          <h3 class="ai-label" id="{{ workflow.slug }}-rules">{{ workflow.rules.heading }}</h3>
          <div class="ai-rules__groups">
            {% for group in workflow.rules.groups %}
              <div class="ai-rules__group flow">
                <h4 class="ai-rules__heading">{{ group.heading }}</h4>
                <ul role="list">
                  {% for item in group.items %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
                {% if group.note %}
                  <p class="ai-rules__note">{{ group.note }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          <p class="ai-rules__silence">{{ workflow.rules.silence }}</p>
        </section>
      {% endif %}

      {% for note in workflow.notes %}
        <div class="ai-note flow">
          {% if note.heading %}
            <h3 class="ai-label">{{ note.heading }}</h3>
          {% endif %}
          {% for paragraph in note.paragraphs %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      {% endfor %}

      {% if workflow.topics %}
        <details class="ai-extra">
          <summary>{{ workflow.topics.summary }}</summary>
          <ul class="ai-topics" role="list">
            {% for item in workflow.topics.items %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
    </article>
  {% endfor %}

  <section class="ai-section flow" aria-labelledby="ai-learning">
    <h2 id="ai-learning" class="ai-section__title">What I'm learning</h2>
    <p>{{ aiWorkflows.learning.intro }}</p>
  </section>

  <section class="ai-section ai-section--aside flow" aria-labelledby="ai-experiments">
    <h2 id="ai-experiments" class="ai-section__title">Earlier experiments</h2>
    <p>{{ aiWorkflows.experiments.intro }}</p>
    <ul class="ai-experiments" role="list">
      {% for item in aiWorkflows.experiments.items %}
        <li><span class="ai-experiments__name">{{ item.name }}</span>, {{ item.note }}</li>
      {% endfor %}
    </ul>
  </section>

  <p class="ai-updated">
    Last updated
    <time datetime="{{ aiWorkflows.updated }}">{{ aiWorkflows.updatedLabel }}</time>
  </p>
</div>

{% css "local" %}
  {% include "css/ai.css" %}
{% endcss %}

{% js "defer" %}
  {% include "scripts/dialog.js" %}
{% endjs %}
