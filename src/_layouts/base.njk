<!doctype html>
<html lang="{{ meta.lang }}">
  <!-- The order of elements in the head follows recommendations by Harry Roberts. learn more here: https://www.youtube.com/watch?v=MHyAOZ45vnU -->

  <head>
    <!-- 1 charset/viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- 2 title -->
    <title>
      {%- if title -%}
        {{- title -}}
      {%- else -%}
        {{- meta.siteName -}}
      {%- endif -%}
    </title>

    <base href="{{ page.url }}" />

    <!-- 3 font preloads (before inlined CSS so the browser can fetch sooner) -->
    {% include "head/preloads.njk" %}

    <!-- 4 synchronous js  -->
    {% include "head/js-inline.njk" %}

    <!-- 5 schema settings -->
    {% include "head/schema.njk" %}

    <!-- 6 CSS  -->
    {% include "head/css-inline.njk" %}

    <!-- 7 defer  -->
    {% include "head/js-defer.njk" %}

    <!-- 8 meta tags, icons, open graph etc.  -->
    {% include "head/meta-info.njk" %}
  </head>

  <body class="{{ layout }}{% if page.url == '/' %} has-pixel-hero{% endif %}">
    {% set indicateActiveHome %}
      {% if page.url == "/" %}
        aria-current=page
      {% endif %}
    {% endset %}
    {% if compactHeader %}
      {% include "partials/header-compact.njk" %}
    {% else %}
      {% include "partials/header.njk" %}
    {% endif %}

    <main id="main" class="flow">{{ content | safe }}</main>

    {% include "partials/footer.njk" %}
    {%- if meta.easteregg -%}
      <custom-easteregg keyword="stefan" shape="♟" particle-count="40"></custom-easteregg>
      <script type="module">
        const loadEgg = () => import('/assets/scripts/components/custom-easteregg.js');
        if ('requestIdleCallback' in window) requestIdleCallback(loadEgg, {timeout: 2000});
        else window.addEventListener('load', loadEgg, {once: true});
      </script>
    {%- endif -%}
  </body>
</html>
