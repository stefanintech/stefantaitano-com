<!doctype html>
<html lang="{{ meta.lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {%- if title -%}
        {{- title -}}
      {%- else -%}
        {{- meta.siteName -}}
      {%- endif -%}
    </title>
    <link
      rel="preload"
      href="/assets/fonts/caveat/caveat-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {% include "head/js-inline.njk" %}
    <meta name="robots" content="{{ robots or 'index,follow' }}" />
    <meta name="theme-color" content="{{ meta.themeDark }}" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="{{ meta.themeLight }}" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    {%- if eleventy.env.runMode === "serve" %}
      <link rel="stylesheet" href="{% getBundleFileUrl "css", "rasa" %}" />
    {%- else %}
      <style>{% getBundle "css", "rasa" %}</style>
    {%- endif %}
    {% css "rasa" %}{% include "css/rasa-site.css" %}{% endcss %}
    {% include "head/js-defer.njk" %}
  </head>
  <body>
    {% include "rasa/header.njk" %}
    <main id="main">
      <div class="column intro">{{ content | safe }}</div>
    </main>
    {% include "rasa/footer.njk" %}
  </body>
</html>
