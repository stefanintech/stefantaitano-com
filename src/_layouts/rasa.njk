<!doctype html>
<html lang="{{ meta.lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      {%- if title -%}
        {{- title -}}
      {%- else -%}
        {{- meta.siteName -}}
      {%- endif -%}
    </title>

    <base href="{{ page.url }}" />

    <link
      rel="preload"
      href="/assets/fonts/caveat/caveat-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />

    {# Same inline theme script and storage key as the live layout, so a stored choice carries over. #}
    {% include "head/js-inline.njk" %}

    {% include "head/schema.njk" %}

    {% css "rasa" %}{% include "css/rasa-site.css" %}{% endcss %}
    {%- if eleventy.env.runMode === "serve" %}
      <link rel="stylesheet" href="{% getBundleFileUrl "css", "rasa" %}">
    {%- else %}
      <style>{% getBundle "css", "rasa" %}</style>
    {%- endif %}

    {% include "head/js-defer.njk" %}

    {% include "head/meta-info.njk" %}
  </head>

  <body>
    {% include "rasa/header.njk" %}

    <main id="main">{{ content | safe }}</main>

    {% include "rasa/footer.njk" %}
    {%- if meta.easteregg and not compactHeader -%}
      <custom-easteregg keyword="stefan" shape="♟" particle-count="40"></custom-easteregg>
      <script type="module">
        const loadEgg = () => import('/assets/scripts/components/custom-easteregg.js');
        if ('requestIdleCallback' in window) requestIdleCallback(loadEgg, {timeout: 2000});
        else window.addEventListener('load', loadEgg, {once: true});
      </script>
    {%- endif -%}
  </body>
</html>
