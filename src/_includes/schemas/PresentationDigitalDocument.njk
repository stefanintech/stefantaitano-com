<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "PresentationDigitalDocument",
    "@id": "{{ meta.url }}{{ page.url }}#presentation",
    "name": "{{ title }}",
    "description": "{{ description }}",
    "url": "{{ meta.url }}{{ page.url }}",
    "inLanguage": "{{ meta.lang }}",
    "about": {
      "@type": "Event",
      "name": "{{ event }}"
    },
    "author": {
      "@type": "Person",
      "@id": "{{ meta.url }}#person",
      "name": "{{ meta.author.name }}",
      "url": "{{ meta.url }}"
    },
    "isPartOf": {
      "@id": "{{ meta.url }}#website"
    },
    "associatedMedia": [
      {%- if youtubeId %}
      {
        "@type": "VideoObject",
        "name": "{{ title }}",
        "description": "{{ description }}",
        "contentUrl": "https://www.youtube.com/watch?v={{ youtubeId }}{%- if youtubeStart %}&t={{ youtubeStart }}s{%- endif %}"
      },
      {%- endif %}
      {
        "@type": "MediaObject",
        "name": "Interactive slides",
        "contentUrl": "{{ meta.url }}{{ slidesUrl }}"
      }
    ]
  }
</script>
