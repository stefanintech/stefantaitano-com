<h1 class="visually-hidden">{{ meta.siteName }}</h1>
{%- if siteCopy.intro %}
<p class="rasa-intro">{{ siteCopy.intro }}</p>
{%- endif %}
{%- if siteCopy.linkLine.length %}
<nav class="rasa-linkline" aria-label="{{ siteCopy.linkLineLabel }}">
  <ul role="list">
    {%- for link in siteCopy.linkLine %}
    <li><a href="{{ link.url }}">{{ link.label }}</a></li>
    {%- endfor %}
  </ul>
</nav>
{%- endif %}

{% set stream = collections.homeStream %}
{% include "rasa/stream.njk" %}
