{% set board = lichess.scoreboard %}
{% set chart = lichess.ogChart %}
{% set rating = board.currentRating %}
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1200"
  height="630"
  viewBox="0 0 1200 630"
  role="img"
  aria-labelledby="title desc"
>
  <title id="title">Stefan Taitano · Lichess Rapid</title>
  <desc id="desc">
    {%- if rating != null -%}
      Rapid rating {{ rating }}. {{ board.statusLine }}
    {%- else -%}
      Lichess Rapid experiment, target {{ experiment.target }}.
    {%- endif -%}
  </desc>
  {% include "rasa/og-chrome.njk" %}

  {% if chart %}
    <polyline fill="none" stroke="#b45309" stroke-opacity="0.4" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" points="{{ chart.polyline }}" />
    <circle cx="{{ chart.last.x }}" cy="{{ chart.last.y }}" r="9" fill="#b45309" fill-opacity="0.85" />
  {% endif %}

  <text x="88" y="120" fill="#686258" font-family="Helvetica, Arial, Liberation Sans, sans-serif" font-size="22">Lichess Rapid</text>

  <text x="80" y="330" fill="#322d25" font-family="Caveat, Bradley Hand, cursive" font-size="200" font-weight="600">{% if rating != null %}{{ rating }}{% else %}—{% endif %}</text>

  <text fill="#686258" font-family="Helvetica, Arial, Liberation Sans, sans-serif" font-size="30">
    <tspan x="88" y="400">
      {%- if board.status == 'done' -%}
        Reached {{ experiment.target }}
      {%- elif board.status == 'climbing' -%}
        Aiming for {{ experiment.target }}
      {%- else -%}
        Target {{ experiment.target }}
      {%- endif -%}
    </tspan>
    <tspan x="88" y="446">No deadline</tspan>
  </text>
</svg>
