{#- One post in the home stream. Set `post`. -#}
<article class="rasa-card rasa-card--post">
  <p class="rasa-card__type">Post</p>
  <h2 class="rasa-card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p class="rasa-card__date"><time datetime="{{ post.date | formatDateUtc('YYYY-MM-DD') }}">{{ post.date | formatDateUtc('MMMM D, YYYY') }}</time></p>
  {%- if post.data.description %}
  <p>{{ post.data.description }}</p>
  {%- endif %}
</article>
