<footer class="rasa-footer">
  <nav aria-label="{{ meta.navigation.ariaExplore }}">
    <ul role="list">
      <li><a href="/next-2027/"{% if page.url == "/next-2027/" %} aria-current="page"{% endif %}>Home</a></li>
      <li><a href="/next-2027/now/"{% if page.url == "/next-2027/now/" %} aria-current="page"{% endif %}>Now</a></li>
      <li><a href="/articles/">Posts</a></li>
      <li><a href="/checkins/">Check-ins</a></li>
    </ul>
  </nav>

  <details class="next-more">
    <summary>More</summary>
    <ul role="list">
      <li><a href="/resume/">Resume</a></li>
      {% for feedLink in meta.blog.feedLinks %}
        <li><a href="{{ feedLink.url }}" rel="alternate" type="{{ feedLink.type }}">{{ feedLink.title }}</a></li>
      {% endfor %}
      {% for item in navigation.legal %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
      {% endfor %}
    </ul>
  </details>

  {# The IDs and data-theme-switcher are what theme-toggle.js binds to. #}
  <div class="rasa-theme require-js" role="region" aria-labelledby="theme-switcher-label" data-theme-switcher>
    <span id="theme-switcher-label">{{ meta.themeSwitch.title }}</span>
    <button type="button" id="light-theme-toggle" data-theme="light">{{ meta.themeSwitch.light }}</button>
    <button type="button" id="dark-theme-toggle" data-theme="dark">{{ meta.themeSwitch.dark }}</button>
  </div>

  {% if showPuzzle %}
    <div class="next-footer__end">
      <button type="button" class="next-knight" data-puzzle-open aria-label="{{ next2027PuzzleCopy.knightLabel }}">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <polygon points="8,36 8,30 14,28 12,20 16,14 22,12 24,16 22,18 28,22 32,20 34,24 28,28 28,36"></polygon>
        </svg>
      </button>
      <p class="rasa-footer__copy">&copy; {% year %} {{ meta.siteName }}</p>
    </div>
  {% else %}
    <p class="rasa-footer__copy">&copy; {% year %} {{ meta.siteName }}</p>
  {% endif %}
</footer>
