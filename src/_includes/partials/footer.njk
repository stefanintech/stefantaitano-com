<footer class="site-footer mt-l-xl p-s-m">
  <div class="wrapper">
    <div class="cluster gutter-xs">
      <nav class="cluster text-step-0" aria-label="{{ meta.navigation.ariaExplore }}">
        &copy; {% year %}
        <a href="/" {{ indicateActiveHome }}
          ><span class="font-display">{{ meta.siteName }}</span>
        </a>

        {% for item in navigation.bottom %}
          <a
            href="{{ item.url }}"
            {% if item.external %}
              rel="noopener"
            {% else %}
              {{ helpers.getLinkActiveState(item.url, page.url) | safe }}
            {% endif %}
            >{{ item.text }}</a
          >
        {% endfor %}
      </nav>

      <nav class="cluster text-step-0" aria-label="{{ meta.navigation.ariaBottom }}">
        {% for item in navigation.legal %}
          <a
            href="{{ item.url }}"
            {{ helpers.getLinkActiveState(item.url, page.url) | safe }}
            >{{ item.text }}</a
          >
        {% endfor %}
      </nav>

      {% if not compactHeader %}
      <nav class="cluster" aria-label="{{ meta.navigation.ariaPlatforms }}">
        <!-- gets the first item from the feed loop set in meta -->
        <a
          href="{{ meta.blog.feedLinks[0].url }}"
          rel="alternate"
          type="{{ meta.blog.feedLinks[0].type }}"
          class="button"
          data-icon
        >
          <span class="visually-hidden">{{ meta.blog.feedLinks[0].title }}</span>
          {% svg "misc/rss" %}
        </a>

        {% for key, value in personal.platforms %}
          {% if value != "" %}
            <!-- regular platforms -->
            <a class="no-indicator button" data-icon href="{{ value }}" rel="me">
              <span class="visually-hidden">{{ key | capitalize }}</span>
              {% svg 'platform/' + key %}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
      {% endif %}
    </div>

    {% if not compactHeader %}
      {% include 'partials/theme-switch.njk' %}
    {% endif %}

    {# Three digits on purpose. This experiment will not hit 1000 games. #}
    {% if not compactHeader and lichess.scoreboard and lichess.scoreboard.games != none %}
      {% set games = lichess.scoreboard.games %}
      {% set since = experiment.start | formatDateUtc('D MMM') %}
      <p class="hit-counter-wrap">
        <a
          class="hit-counter no-indicator"
          href="/chess/"
          aria-label="{{ games }} rated Rapid game{% if games != 1 %}s{% endif %} since {{ since }}. Full Rapid scoreboard."
        >
          <span class="hit-counter__digits" aria-hidden="true">
            <span class="hit-counter__digit">{{ ((games / 100) | round(0, 'floor')) % 10 }}</span>
            <span class="hit-counter__digit">{{ ((games / 10) | round(0, 'floor')) % 10 }}</span>
            <span class="hit-counter__digit">{{ games % 10 }}</span>
          </span>
        </a>
      </p>
    {% endif %}

    <aside class="creator | cluster gutter-2xs text-step-min-1 mt-xl">
      Made with <span class="visually-hidden">love</span> <span>{% svg "misc/heart" %}</span> and
      <a class="no-indicator" href="https://www.11ty.dev/">
        <span class="visually-hidden">Eleventy</span>
        {% svg "misc/11ty" %}
      </a>
      by
      <a href="{{ meta.creator.website }}">{{ meta.creator.name }}</a>
    </aside>
  </div>
</footer>
