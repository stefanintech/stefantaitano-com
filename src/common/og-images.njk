---
pagination:
  data: collections.allPosts
  size: 1
  alias: post
permalink: '/assets/og-images/{{ post.data.title | slugify }}-preview.svg'
eleventyExcludeFromCollections: true
---

<svg
  width="1200"
  height="630"
  viewBox="0 0 1200 630"
  version="1.1"
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  role="img"
  aria-labelledby="title"
>
  {% set titleInLines = post.data.title | splitlines(24) %}
  {% set numberOfLines = titleInLines.length %}
  {% if numberOfLines == 1 %}
    {% set verticalStartingPoint = 330 %}
  {% elseif numberOfLines == 2 %}
    {% set verticalStartingPoint = 292 %}
  {% elseif numberOfLines == 3 %}
    {% set verticalStartingPoint = 254 %}
  {% elseif numberOfLines == 4 %}
    {% set verticalStartingPoint = 216 %}
  {% else %}
    {% set verticalStartingPoint = 186 %}
  {% endif %}

  <title id="title">{{ post.data.title }}</title>
  {% include "partials/og-chrome.njk" %}

  <text
    fill="#686258"
    font-family="Helvetica, Arial, Liberation Sans, sans-serif"
    font-size="22"
    letter-spacing="0.16em"
  >
    <tspan x="88" y="128">ARTICLE · {{ post.date | formatDate('MMMM D, YYYY') | upper }}</tspan>
  </text>

  <text
    fill="#19150e"
    font-family="Fraunces 72pt, Georgia, serif"
    font-size="56"
    font-weight="900"
  >
    {% for line in titleInLines %}
      <tspan x="88" y="{{ verticalStartingPoint + loop.index0 * 72 }}">{{ line }}</tspan>
    {% endfor %}
  </text>

  <line x1="88" y1="524" x2="1112" y2="524" stroke="#e7e4de" stroke-width="2" />

  <text
    x="88"
    y="572"
    fill="#686258"
    font-family="Atkinson Hyperlegible, system-ui, sans-serif"
    font-size="24"
  >stefantaitano.com</text>

  <text
    x="1112"
    y="572"
    text-anchor="end"
    fill="#686258"
    font-family="Atkinson Hyperlegible, system-ui, sans-serif"
    font-size="22"
    letter-spacing="0.12em"
  >STEFAN TAITANO</text>
</svg>
